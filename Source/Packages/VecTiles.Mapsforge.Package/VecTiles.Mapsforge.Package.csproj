<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>VecTiles.Mapsforge</PackageId>
    <Title>VecTiles.Mapsforge</Title>
    <Description>Mapsforge support for the VecTiles.NET vector tile mapping stack. It bundles VecTiles.Styles.Mapsforge (Mapsforge render theme parser) and VecTiles.Converters.Mapsforge which converts raw Mapsforge vector tiles to VectorTile objects.</Description>
    <PackageTags>map;maps;geo;gis;vector-tiles;tile;tiles;mapsforge;styles</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CopyProjectReferencesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Styles\VecTiles.Styles.Mapsforge\VecTiles.Styles.Mapsforge.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\Converters\VecTiles.Converters.Mapsforge\VecTiles.Converters.Mapsforge.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- NuGet dependencies on the VecTiles packages, only used while packing
       (pack-nuget.sh passes -p:CreateNuGets=true). During normal builds the
       projects are referenced directly, so no NuGet feed is needed. -->
  <ItemGroup Condition="'$(CreateNuGets)' == 'true'">
    <PackageReference Include="VecTiles.Common" Version="$(Version)" />
  </ItemGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(ReferencePath->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

</Project>
