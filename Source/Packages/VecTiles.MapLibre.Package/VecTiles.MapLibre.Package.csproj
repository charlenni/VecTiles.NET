<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>VecTiles.MapLibre</PackageId>
    <Title>VecTiles.MapLibre</Title>
    <Description>MapLibre support for the VecTiles.NET vector tile mapping stack. It bundles VecTiles.Styles.MapLibre (styles in the Mapbox/MapLibre style format) and VecTiles.Converters.MVT convert Mapbox/MapLibre vector tiles (MVT, PBF optionally zipped) to VectorTile objects.</Description>
    <PackageTags>map;maps;geo;gis;vector-tiles;tile;tiles;openmaptiles;mapbox;maplibre;mvt;pmtiles;styles</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CopyProjectReferencesToPackage</TargetsForTfmSpecificContentInPackage>
    <RootNamespace>VecTiles.MapLibre.Package</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Styles\VecTiles.Styles.MapLibre\VecTiles.Styles.MapLibre.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\Converters\VecTiles.Converters.MVT\VecTiles.Converters.MVT.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="3.4.40" />
  </ItemGroup>

  <!-- NuGet dependencies on the VecTiles packages, only used while packing
       (pack-nuget.sh passes -p:CreateNuGets=true). During normal builds the
       projects are referenced directly, so no NuGet feed is needed. -->
  <ItemGroup Condition="'$(CreateNuGets)' == 'true'">
    <PackageReference Include="VecTiles.Common" Version="$(Version)" />
  </ItemGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(ReferencePath->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

</Project>
