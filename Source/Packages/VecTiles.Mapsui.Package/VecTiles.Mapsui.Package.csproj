<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>VecTiles.Mapsui</PackageId>
    <Title>VecTiles.Mapsui</Title>
    <Description>Mapsui integration for the VecTiles.NET vector tile mapping stack. Provides VecTiles.Controls.Mapsui, which connects the VecTiles vector tile data sources, styles and the Skia based renderer to Mapsui, e.g. to display styled vector tile maps inside a Mapsui map control.</Description>
    <PackageTags>map;maps;geo;gis;vector-tiles;tile;tiles;openmaptiles;mapsui;controls</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CopyProjectReferencesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Controls\VecTiles.Control.Mapsui\VecTiles.Controls.Mapsui.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mapsui" Version="5.2.0" />
    <PackageReference Include="Mapsui.Rendering.Skia" Version="5.2.0" />
    <PackageReference Include="Mapsui.Tiling" Version="5.2.0" />
    <PackageReference Include="NetTopologySuite.IO.VectorTiles" Version="1.1.0" />
    <PackageReference Include="protobuf-net" Version="3.4.40" />
  </ItemGroup>

  <!-- NuGet dependencies on the VecTiles packages, only used while packing
       (pack-nuget.sh passes -p:CreateNuGets=true). During normal builds the
       projects are referenced directly, so no NuGet feed is needed. -->
  <ItemGroup Condition="'$(CreateNuGets)' == 'true'">
    <PackageReference Include="VecTiles.Skia" Version="$(Version)" />
  </ItemGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(ReferencePath->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

</Project>
