<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\Files\OpenMapTiles\osm-liberty-for-mapsforge.json">
      <Link>Files/OpenMapTiles/osm-liberty-for-mapsforge.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\Files\OpenMapTiles\osm-liberty.json" Link="Files\OpenMapTiles\osm-liberty.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\Files\OpenMapTiles\zuerich.map">
      <Link>Files/OpenMapTiles/zuerich.map</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\..\..\Files\OpenMapTiles\Sprites\osm-liberty.json" Link="Files\OpenMapTiles\Sprites\osm-liberty.json" />
    <EmbeddedResource Include="..\..\..\Files\OpenMapTiles\Sprites\osm-liberty.png" Link="Files\OpenMapTiles\Sprites\osm-liberty.png" />
    <EmbeddedResource Include="..\..\..\Files\OpenMapTiles\Sprites\osm-liberty@2x.json" Link="Files\OpenMapTiles\Sprites\osm-liberty%402x.json" />
    <EmbeddedResource Include="..\..\..\Files\OpenMapTiles\Sprites\osm-liberty@2x.png" Link="Files\OpenMapTiles\Sprites\osm-liberty%402x.png" />
  </ItemGroup>

  <ItemGroup>

    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Mapsui.Avalonia" Version="5.2.0" />
    <PackageReference Include="protobuf-net" Version="3.4.40" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Source\Controls\VecTiles.Control.Mapsui\VecTiles.Controls.Mapsui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Files\OpenMapTiles\Sprites\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\Files\OpenMapTiles\LICENSE.md" Link="Files\OpenMapTiles\LICENSE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\Files\OpenMapTiles\natural_earth_2_shaded_relief.raster.mbtiles" Link="Files\OpenMapTiles\natural_earth_2_shaded_relief.raster.mbtiles">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\Files\OpenMapTiles\zurich.mbtiles" Link="Files\OpenMapTiles\zurich.mbtiles">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
